-	   satisfies_hash_partition('text_hashp'::regclass, 2, 1, 'xxx'::text) AS satisfies;
-
--- cleanup
-DROP TABLE mchash;
-DROP TABLE mcinthash;
-DROP TABLE text_hashp;
