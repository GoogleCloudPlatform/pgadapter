-
--- First create tables employing the new AM using USING
-
--- plain CREATE TABLE
-CREATE TABLE tableam_tbl_heap2(f1 int) USING heap2;
-INSERT INTO tableam_tbl_heap2 VALUES(1);
-SELECT f1 FROM tableam_tbl_heap2 ORDER BY f1;
