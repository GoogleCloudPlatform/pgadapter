{
   "compilerOptions": {
      "lib": [
         "es2022",
         "dom"
      ],
      "target": "es2022",
      "module": "commonjs",
      "moduleResolution": "node",
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "strict": false,
      "noImplicitAny": false,
      "types": [
         "node"
      ]
   }
}