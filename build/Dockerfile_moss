################################################################################
#                                     BUILD                                    #
################################################################################

FROM --platform=$BUILDPLATFORM marketplace.gcr.io/google/debian12:latest AS build

ARG DEBIAN_FRONTEND=noninteractive

# Bootstrap Artifact Registry APT transport and install JDK + Maven via Airlock APT.
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        ca-certificates curl gnupg && \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg && \
    curl -fsSL https://us-apt.pkg.dev/doc/repo-signing-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/artifact-registry.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt apt-transport-artifact-registry-stable main" \
        > /etc/apt/sources.list.d/artifact-registry.list && \
    apt-get update && \
    apt-get install --no-install-recommends -y apt-transport-artifact-registry && \
    rm -f /etc/apt/sources.list.d/* /etc/apt/sources.list && \
    echo "deb [signed-by=/usr/share/keyrings/artifact-registry.gpg] ar+https://us-apt.pkg.dev/projects/artifact-foundry-prod standard-debian-bookworm-3p-l1 main" \
        > /etc/apt/sources.list.d/artifact-registry.list

RUN --mount=type=secret,id=credentials \
    if [ -f /run/secrets/credentials ]; then export GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/credentials; fi && \
    apt-get -o APT::Sandbox::User=root update && \
    apt-get -o APT::Sandbox::User=root install --no-install-recommends -y \
        openjdk-17-jdk-headless \
        maven && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy over build files to docker image.
COPY LICENSE ./
COPY CONTRIBUTING.md ./
COPY README.md ./
COPY NOTIFICATIONS.md ./
COPY logging.properties ./
COPY src src/
COPY pom.xml ./
COPY license-checks.xml ./
COPY java.header ./

COPY settings_wagon_moss.xml /root/.m2/settings_wagon_moss.xml
# Download the artifactregistry-maven-wagon
RUN mvn -B -s /root/.m2/settings_wagon_moss.xml dependency:get -Dartifact="com.google.cloud.artifactregistry:artifactregistry-maven-wagon:2.2.4"

# Copy airlock settings
COPY settings_moss.xml /root/.m2/settings.xml

COPY extensions_moss.xml .mvn/extensions.xml

# Build from source.
RUN --mount=type=secret,id=credentials \
    if [ -f /run/secrets/credentials ]; then export GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/credentials; fi && \
    mvn -B -s /root/.m2/settings.xml package -Passembly -Dmaven.test.skip=true -Dfmt.skip=true

################################################################################
#                                APT BOOTSTRAP                                 #
################################################################################

FROM marketplace.gcr.io/google/debian12:latest AS apt-bootstrap

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        ca-certificates curl gnupg && \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg && \
    curl -fsSL https://us-apt.pkg.dev/doc/repo-signing-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/artifact-registry.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt apt-transport-artifact-registry-stable main" \
        > /etc/apt/sources.list.d/artifact-registry.list && \
    apt-get update && \
    apt-get install --no-install-recommends -y apt-transport-artifact-registry

################################################################################
#                                   RELEASE                                    #
################################################################################

FROM marketplace.gcr.io/google/debian12:latest

ARG DEBIAN_FRONTEND=noninteractive

# Upgrade OS packages to Debian 13 (trixie) and install OpenJDK 25 JRE strictly from Airlock APT
# using transient bind-mounts of ar+https and the AR keyring.
RUN --mount=type=secret,id=credentials \
    --mount=type=bind,from=apt-bootstrap,source=/usr/lib/apt/methods/ar+https,target=/usr/lib/apt/methods/ar+https \
    --mount=type=bind,from=apt-bootstrap,source=/usr/share/keyrings/artifact-registry.gpg,target=/usr/share/keyrings/artifact-registry.gpg \
    --mount=type=bind,from=apt-bootstrap,source=/etc/ssl/certs/ca-certificates.crt,target=/tmp/ca-certificates.crt \
    if [ -f /run/secrets/credentials ]; then export GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/credentials; fi && \
    mkdir -p /etc/ssl/certs && \
    cp /tmp/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt && \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then sed 's/bookworm/trixie/g' /etc/apt/sources.list.d/debian.sources > /tmp/debian.sources; fi && \
    rm -f /etc/apt/sources.list.d/* /etc/apt/sources.list && \
    printf '%s\n' \
        "deb [signed-by=/usr/share/keyrings/artifact-registry.gpg] ar+https://us-apt.pkg.dev/projects/artifact-foundry-prod standard-debian-bookworm-3p-l1 main" \
        "deb [signed-by=/usr/share/keyrings/artifact-registry.gpg] ar+https://us-apt.pkg.dev/projects/artifact-foundry-prod standard-debian-trixie-3p-l1 main" \
        > /etc/apt/sources.list.d/artifact-registry.list && \
    apt-get -o APT::Sandbox::User=root update && \
    apt-get -o APT::Sandbox::User=root \
        -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confnew" \
        dist-upgrade --no-install-recommends -y && \
    apt-get -o APT::Sandbox::User=root install --no-install-recommends -y \
        ca-certificates \
        openjdk-25-jre-headless && \
    rm -f /etc/apt/sources.list.d/artifact-registry.list && \
    if [ -f /tmp/debian.sources ]; then mv /tmp/debian.sources /etc/apt/sources.list.d/debian.sources; fi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /build/target/pgadapter /home/pgadapter
COPY --from=build /build/LICENSE /home/pgadapter/
COPY --from=build /build/CONTRIBUTING.md /home/pgadapter/
COPY --from=build /build/README.md /home/pgadapter/
COPY --from=build /build/NOTIFICATIONS.md /home/pgadapter/
COPY --from=build /build/logging.properties /home/pgadapter/

# Add startup script.
ADD build/startup.sh /home/pgadapter/startup.sh
RUN chmod +x /home/pgadapter/startup.sh

ENTRYPOINT ["/bin/bash", "/home/pgadapter/startup.sh"]
